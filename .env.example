# =====================================================================
# HIMAROH TRAVELS — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# Lines marked REQUIRED must be set for the app to build/run.
# =====================================================================

# --- Database (REQUIRED) ---
# Pooled connection (used at runtime, e.g. via PgBouncer/Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/himaroh?schema=public&pgbouncer=true"
# Direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/himaroh?schema=public"

# --- Auth (REQUIRED) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Razorpay (REQUIRED for live payments; app runs in mock mode if unset) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Set to "true" to force mock/test payment mode even if keys are present (dev only)
PAYMENTS_MOCK_MODE="true"

# --- Email (REQUIRED for booking/confirmation emails) ---
RESEND_API_KEY=""
EMAIL_FROM="Himaroh Travels <bookings@himarohtravels.com>"

# --- Public site config (REQUIRED) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="918527393969"

# --- Object storage (REQUIRED before enabling real image uploads) ---
STORAGE_PROVIDER="supabase" # or "s3"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""

# --- Rate limiting (OPTIONAL — public form protection) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Analytics (OPTIONAL) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
